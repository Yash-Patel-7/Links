{
  "name": "backend",
  "version": "1.0.0",
  "bin": {
    "backend": "dist/Links.cjs"
  },
  "scripts": {
    "clean": "rm -rf dist && rm -rf bin && rm -rf data",
    "format": "prettier --write --ignore-unknown .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix",
    "bundle:assets": "cp -Rpf ../frontend/build dist",
    "bundle": "tsx esbuild.config.ts && npm run bundle:assets",
    "test": "jest",
    "package:assets": "mkdir -p bin/Links && cp -Rpf ../frontend/build bin/Links",
    "package": "npm run package:assets && pkg --sea --config pkg-config.json dist/Links.cjs",
    "dev:build": "npm run clean && npm run format && npm run typecheck && npm run lint && npm run bundle",
    "qa:build": "npm run dev:build && npm run test",
    "build": "npm run qa:build && npm run package",
    "start": "node dist/Links.cjs",
    "prepare": "cd .. && husky backend/.husky",
    "precommit": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "async-mutex": "^0.5.0",
    "express": "^5.1.0",
    "http-status-codes": "^2.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.10",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "@yao-pkg/pkg": "^6.5.1",
    "esbuild": "^0.25.5",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jest": "^30.0.4",
    "jiti": "^2.4.2",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
